# Copy this file to backend/.env and fill in values from your own provider dashboards.
# Never commit backend/.env or real credentials.

# Clerk backend authentication
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY
CLERK_JWT_KEY="YOUR_CLERK_JWT_PUBLIC_KEY_OR_PEM_CONTENT"
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Cloud or your own Qdrant instance
QDRANT_URL=https://YOUR_QDRANT_CLUSTER_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY

# Neon PostgreSQL connection string (SQLAlchemy-compatible)
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require
